VITE_SUPABASE_URL=
# Server-side secret, never a VITE_ variable and never in the browser.
# Vercel: required to create and edit guide and driver accounts in the admin page.
# Render: required for Telegram booking and chat memory (functions book_departure_telegram, table telegram_chats).
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_PAYMENT_MODE=

# For isolated local Supabase UI tests use `npm run dev:local-test`.
# That mode reads .env.local-test (localhost) and ignores writing to production.
# Copy local `npx supabase status` keys into gitignored .env.local-test.local if needed.
PAYMENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
SMS_GATEWAY_URL=
WHATSAPP_GATEWAY_URL=

# Server-only, never prefix with VITE_.
PYTHON_BACKEND_URL=
IDEAS_API_SECRET=
CHAT_INTENT_API_SECRET=
# Render only, optional. OPENAI_COPY_MODEL writes the Armenian text of new tour ideas
# (falls back to OPENAI_MODEL). TAVILY_API_KEY turns on web search for market research.
OPENAI_COPY_MODEL=
TAVILY_API_KEY=
# Render only, optional. Model and temperature for the tour chat and Telegram bot.
# CHAT_MODEL falls back to OPENAI_MODEL, then gpt-4o-mini. CHAT_TEMPERATURE defaults to 0.4.
CHAT_MODEL=
CHAT_TEMPERATURE=
# Render only. Leave empty here; set the values in the Render service environment.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_SITE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
CORS_ORIGINS=
TRANSPORT_RATE_PER_KM_AMD=
